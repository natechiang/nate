<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Pig Latin &lt;-&gt; English Translator</title>
  <style>
    body { font-family: Arial, sans-serif; max-width: 500px; margin: 40px auto; }
    textarea, input { width: 100%; margin-top: 10px; }
    button { margin-top: 16px; padding: 8px 16px; }
    .output { padding: 10px; background: #fafaff; margin-top: 15px; border-radius: 4px; border: 1px solid #eee; }
    label { font-weight: bold; }
  </style>
</head>
<body>
  <h1>Pig Latin ⇄ English Translator</h1>
  <label for="mode">Select Translation Direction:</label>
  <select id="mode">
    <option value="to-piglatin">English → Pig Latin</option>
    <option value="to-english">Pig Latin → English</option>
  </select>

  <label for="inputText">Enter your sentence:</label>
  <textarea id="inputText" rows="3" placeholder="Type text here..."></textarea>
  
  <button onclick="translate()">Translate</button>

  <div id="result" class="output"></div>

  <script>
    function isVowel(ch, pos) {
      return "aeiouAEIOU".includes(ch) || (ch.toLowerCase() === 'y' && pos !== 0);
    }

    // Extracts trailing punctuation (e.g., "hello!" -> ["hello", "!"])
    function splitWordPunctuation(word) {
      const match = word.match(/^([\w']+)(\W*)$/);
      if (match) return [match[1], match[2]];
      else return [word, ""];
    }

    function piglatinizeWord(word) {
      let [base, punctuation] = splitWordPunctuation(word);

      if (!base) return word;

      const wasCap = /[A-Z]/.test(base[0]);
      const lower = base.toLowerCase();

      let result = "";

      if (isVowel(lower[0], 0)) {
        // Starts with a vowel
        result = lower + "way";
      } else if (lower[0] === 'y') {
        // Starts with 'y', treat as consonant
        result = lower.slice(1) + "y" + "ay";
      } else {
        // Starts with consonant(s), move to end before vowel
        let splitIdx = 0;
        for (let i = 0; i < lower.length; ++i) {
          if (isVowel(lower[i], i)) {
            splitIdx = i;
            break;
          }
        }
        if (splitIdx === 0) { // Edge: no vowels
          result = lower + "ay";
        } else {
          result = lower.slice(splitIdx) + lower.slice(0, splitIdx) + "ay";
        }
      }

      if (wasCap) result = result.charAt(0).toUpperCase() + result.slice(1);
      return result + punctuation;
    }

    function englifyWord(word) {
      let [base, punctuation] = splitWordPunctuation(word);

      if (!base) return word;

      const wasCap = /[A-Z]/.test(base[0]);
      const lower = base.toLowerCase();
      let candidate = "";

      if (lower.endsWith("way")) {
        candidate = lower.slice(0, -3);
      } else if (lower.endsWith("yay")) {
        candidate = lower.slice(0, -3);
      } else if (lower.endsWith("ay")) {
        let body = lower.slice(0, -2);
        // Possibly a 'y' ending from moving 'y'
        if (body.endsWith("y")) {
          candidate = "y" + body.slice(0, -1);
        } else {
          // Try all possible splits, looking for the most likely one
          let found = false;
          for (let i = body.length - 1; i >= 0; --i) {
            if (isVowel(body[i], i) || body[i] === 'y') {
              candidate = body.slice(i+1) + body.slice(0, i+1);
              found = true;
              break;
            }
          }
          // fallback if not found
          if (!found) candidate = body;
        }
      } else {
        candidate = lower;
      }

      if (wasCap && candidate.length > 0) candidate = candidate.charAt(0).toUpperCase() + candidate.slice(1);
      return candidate + punctuation;
    }

    function piglatinizeSentence(sentence) {
      // Split words by spaces, preserving punctuation
      return sentence.split(/\s/).map(piglatinizeWord).join(" ");
    }
    function englifySentence(sentence) {
      return sentence.split(/\s/).map(englifyWord).join(" ");
    }

    function translate() {
      const mode = document.getElementById('mode').value;
      const text = document.getElementById('inputText').value;
      let result = '';
      if (mode === 'to-piglatin') result = piglatinizeSentence(text);
      else result = englifySentence(text);

      document.getElementById('result').textContent = result;
    }
  </script>
</body>
</html>
